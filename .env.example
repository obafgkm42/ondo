# Local Wrangler development only. Store production value with wrangler secret.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me
DISCORD_APPLICATION_PUBLIC_KEY=replace-with-64-character-public-key
DISCORD_GUILD_ID=replace-with-server-id
MANUAL_SCAN_TOKEN=replace-with-a-long-random-value
HYPERLIQUID_COIN=xyz:SP500
REGULAR_SCAN_MINUTES=15
FINAL_HOUR_SCAN_MINUTES=5
BRIEF_INTERVAL_MINUTES=30
MARKET_ACTIVITY_MODE=shadow
FRAGILITY_PERSISTENCE_MODE=off
RESILIENCE_DECAY_SHADOW_MODE=off
MINIMUM_WATCH_PRICE_R=2
MINIMUM_WATCH_CONFIDENCE_SCORE=64
MINIMUM_PRICE_R=3.5
MINIMUM_CONFIDENCE_SCORE=72
WORKER_VERSION=local-dev
